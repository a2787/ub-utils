[Unit]
Description=OmniBlock independent encrypted sync service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/omniblock-sync
ExecStart=/usr/bin/python3 /opt/omniblock-sync/server.py --db /opt/omniblock-sync/data/omniblock-sync.sqlite3 --host 127.0.0.1 --port 8787
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/omniblock-sync/data
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
